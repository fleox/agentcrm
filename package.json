{
  "name": "@fleox-agent-crm/agentcrm",
  "version": "0.9.1",
  "type": "module",
  "description": "The static CRM your AI agent can run: a Twenty / HubSpot-style CRM that runs entirely in the browser or headless through the agentcrm CLI, with data on storage you own.",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agentcrm": "dist/agent/agentcrm.mjs"
  },
  "files": [
    "dist/agent",
    "dist/admin",
    "types/agentcrm-runtime.d.ts",
    "dist/version.json",
    "plugin",
    "changelog.json",
    "README.md",
    "LICENSE"
  ],
  "agentcrm": {
    "minSkillsVersion": "0.1.0",
    "dataSchema": 1
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.agent.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build && node scripts/write-admin-manifest.mjs && vite build --config vite.agent.config.ts && node scripts/write-version.mjs",
    "build:examples": "node scripts/build-examples.mjs",
    "preview": "vite preview",
    "check:skills": "node scripts/check-skills.mjs",
    "hermes:build": "node scripts/build-hermes.mjs",
    "check:hermes": "node scripts/build-hermes.mjs --check && python3 -m unittest discover -s hermes/tests",
    "version": "node scripts/sync-version.mjs && npm run build && node scripts/build-hermes.mjs && git add -A plugin hermes .claude-plugin",
    "gen:runtime-stubs": "node scripts/gen-runtime-stubs.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run check:skills"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/node": "^25.9.9",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "fake-indexeddb": "^6.2.7",
    "firebase": "^11.10.0",
    "happy-dom": "^20.14.6",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.460.0",
    "marked": "^18.1.3",
    "minisearch": "^7.2.0",
    "papaparse": "^5.7.0",
    "postcss": "^8.5.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.7.4",
    "react-is": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fleox/agentcrm.git"
  },
  "homepage": "https://github.com/fleox/agentcrm#readme",
  "keywords": [
    "crm",
    "static",
    "mcp",
    "ai-agent",
    "claude",
    "sales",
    "pipeline",
    "s3",
    "encrypted"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/fleox/agentcrm/issues"
  }
}
